# ─── Promptora AI — environment ─────────────────────────────────────────────
# Copy to .env for local development. On Vercel, set these in Project Settings.
# NEVER commit .env. NEVER put these values in frontend code.

# Public base URL of the site (used for payment return URLs)
APP_URL=https://your-domain.vercel.app

# Port for the standalone server (server/index.js)
PORT=8787

# ─── Database ───────────────────────────────────────────────────────────────
# Local default: SQLite file at ./data/promptora.db (created automatically).
# Production (required on Vercel): Turso / libsql  — free tier works.
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# ─── Payments: sandbox vs live ─────────────────────────────────────────────
# If NO merchant credentials are set at all, SANDBOX MODE engages automatically
# (the whole signed payment pipeline is exercised, payments are marked TEST).
# Force it explicitly with PAYMENT_SANDBOX=true even if keys exist:
# PAYMENT_SANDBOX=true

# ─── Click (https://merchant.click.uz → service settings) ──────────────────
# Prepare/Complete callback URL to paste in Click cabinet:
#   https://your-domain.vercel.app/api/webhooks/click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Optional, if your Click cabinet shows a merchant user id:
# CLICK_MERCHANT_USER_ID=
# Optional comma-separated IP allowlist for Click callbacks (recommended):
# CLICK_ALLOWED_IPS=8.8.8.8,1.1.1.1
# Override checkout host if Click instructs you to (default my.click.uz):
# CLICK_PAY_BASE=https://my.click.uz/services/pay

# ─── Payme (https://merchant.paycom.uz → касса → настройки) ────────────────
# Merchant API endpoint to paste in Payme cabinet (JSON-RPC):
#   https://your-domain.vercel.app/api/webhooks/payme
# Account field name to configure in Payme cabinet:  order_id
PAYME_MERCHANT_ID=
# Production cashbox key:
PAYME_MERCHANT_KEY=
# Test cashbox key (from admin.test.paycom.uz) — used when PAYME_TEST_MODE=true:
# PAYME_TEST_KEY=
# true → test.paycom.uz checkout + test key; false → live checkout
# PAYME_TEST_MODE=false
# Optional overrides (rarely needed):
# PAYME_CHECKOUT_BASE=https://checkout.paycom.uz
# PAYME_TEST_CHECKOUT_BASE=https://test.paycom.uz
